# Copy to .env and adjust. Every value has a sane default; this file is
# only needed when you want to change one.

# The one and only folder local-rag reads documents from.
LOCAL_RAG_DOCUMENTS_DIR=data/documents

# Local stores (all under data/ by default)
LOCAL_RAG_VECTOR_DB_DIR=data/chroma
LOCAL_RAG_MANIFEST_DB=data/manifest.db
LOCAL_RAG_BM25_PATH=data/bm25.json

# Embedding model (small, local, best for RAG at this size)
LOCAL_RAG_EMBEDDING_PROVIDER=sentence-transformers
LOCAL_RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_RAG_EMBEDDING_DIMENSION=384

# Reranker (small cross-encoder)
LOCAL_RAG_RERANKER_PROVIDER=cross-encoder
LOCAL_RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Generation LLM (Ollama on localhost; swap via LLMProvider if you prefer)
LOCAL_RAG_LLM_PROVIDER=ollama
LOCAL_RAG_OLLAMA_BASE_URL=http://localhost:11434
LOCAL_RAG_OLLAMA_MODEL=llama3.2:3b
LOCAL_RAG_LLM_TEMPERATURE=0.1

# Chunking
LOCAL_RAG_TEXT_CHUNK_STRATEGY=section
LOCAL_RAG_CHUNK_SIZE_WORDS=200
LOCAL_RAG_CHUNK_OVERLAP_WORDS=40
LOCAL_RAG_SECTION_MAX_WORDS=400
LOCAL_RAG_MEDIA_SEGMENT_SECONDS=45
LOCAL_RAG_WHISPER_MODEL=base

# Retrieval
LOCAL_RAG_DEFAULT_TOP_K=5
LOCAL_RAG_RERANK_TOP_N=20
LOCAL_RAG_MMR_LAMBDA=0.7
LOCAL_RAG_RRF_K=60
LOCAL_RAG_BM25_K1=1.5
LOCAL_RAG_BM25_B=0.75

# Folder watcher (live sync)
LOCAL_RAG_WATCHER_ENABLED=true
LOCAL_RAG_WATCHER_DEBOUNCE_SECONDS=1.0

# Server
LOCAL_RAG_HOST=0.0.0.0
LOCAL_RAG_PORT=8000
LOCAL_RAG_LOG_LEVEL=INFO
